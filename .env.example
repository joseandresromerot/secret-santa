# PostgreSQL connection string (Docker locally, Neon in production)
DATABASE_URL=postgresql://postgres:postgres@localhost:5434/secret_santa_dev

# Auth.js secret — generate with: npx auth secret
AUTH_SECRET=

# Google OAuth client (https://console.cloud.google.com/apis/credentials)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Gmail account used to send the draw emails (requires an App Password)
# If empty, emails are logged to the console instead of being sent (dev only).
GMAIL_USER=
GMAIL_APP_PASSWORD=

